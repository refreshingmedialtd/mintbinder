generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER  @map("user")
  ADMIN @map("admin")

  @@map("user_role")
}

enum SubscriptionPlan {
  FREE         @map("free")
  PLUS_MONTHLY @map("plus_monthly")
  PLUS_YEARLY  @map("plus_yearly")

  @@map("subscription_plan")
}

enum SubscriptionStatus {
  ACTIVE             @map("active")
  TRIALING           @map("trialing")
  PAST_DUE           @map("past_due")
  CANCELED           @map("canceled")
  INCOMPLETE         @map("incomplete")
  INCOMPLETE_EXPIRED @map("incomplete_expired")
  UNPAID             @map("unpaid")

  @@map("subscription_status")
}

enum ItemType {
  CARD           @map("card")
  SEALED_PRODUCT @map("sealed_product")

  @@map("item_type")
}

enum ItemCondition {
  UNKNOWN      @map("unknown")
  POOR         @map("poor")
  PLAYED       @map("played")
  LIGHT_PLAYED @map("light_played")
  EXCELLENT    @map("excellent")
  NEAR_MINT    @map("near_mint")
  MINT         @map("mint")
  SEALED       @map("sealed")

  @@map("item_condition")
}

enum GradingCompany {
  PSA   @map("psa")
  BGS   @map("bgs")
  CGC   @map("cgc")
  ACE   @map("ace")
  SGC   @map("sgc")
  OTHER @map("other")

  @@map("grading_company")
}

enum SealedProductType {
  BOOSTER_BOX       @map("booster_box")
  BOOSTER_PACK      @map("booster_pack")
  ELITE_TRAINER_BOX @map("elite_trainer_box")
  COLLECTION_BOX    @map("collection_box")
  TIN               @map("tin")
  BLISTER           @map("blister")
  DECK              @map("deck")
  CASE              @map("case")
  OTHER             @map("other")

  @@map("sealed_product_type")
}

enum StorageLocationType {
  BINDER  @map("binder")
  BOX     @map("box")
  DISPLAY @map("display")
  SAFE    @map("safe")
  OTHER   @map("other")

  @@map("storage_location_type")
}

enum WishlistPriority {
  LOW    @map("low")
  MEDIUM @map("medium")
  HIGH   @map("high")
  GRAIL  @map("grail")

  @@map("wishlist_priority")
}

enum CollectionEventType {
  ADDED    @map("added")
  EDITED   @map("edited")
  SOLD     @map("sold")
  REMOVED  @map("removed")
  GRADED   @map("graded")
  MOVED    @map("moved")
  IMPORTED @map("imported")

  @@map("collection_event_type")
}

enum CatalogueVisibility {
  GLOBAL         @map("global")
  PRIVATE        @map("private")
  PENDING_REVIEW @map("pending_review")

  @@map("catalogue_visibility")
}

enum NotificationDigestFrequency {
  OFF    @map("off")
  DAILY  @map("daily")
  WEEKLY @map("weekly")

  @@map("notification_digest_frequency")
}

enum NotificationDeliveryStatus {
  CLAIMED   @map("claimed")
  SENT      @map("sent")
  AMBIGUOUS @map("ambiguous")

  @@map("notification_delivery_status")
}

enum PasswordResetOutboxStatus {
  QUEUED     @map("queued")
  CLAIMED    @map("claimed")
  SENT       @map("sent")
  DISCARDED  @map("discarded")
  UNRESOLVED @map("unresolved")

  @@map("password_reset_outbox_status")
}

enum JobRunType {
  BILLING_CHECKOUT_RETIREMENT @map("billing_checkout_retirement")
  PASSWORD_RESET_DELIVERY     @map("password_reset_delivery")
  PRICE_ALERTS           @map("price_alerts")
  CATALOGUE_REFRESH      @map("catalogue_refresh")
  PRICING_REFRESH        @map("pricing_refresh")
  SEALED_PRICING_REFRESH @map("sealed_pricing_refresh")

  @@map("job_run_type")
}

enum JobRunStatus {
  RUNNING   @map("running")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")

  @@map("job_run_status")
}

enum BinderVisibility {
  PRIVATE  @map("private")
  UNLISTED @map("unlisted")

  @@map("binder_visibility")
}

enum BillingWebhookStatus {
  PROCESSING @map("processing")
  SUCCEEDED  @map("succeeded")
  FAILED     @map("failed")

  @@map("billing_webhook_status")
}

enum BillingCustomerProvenance {
  APP_CREATED         @map("app_created")
  PROVIDER_MATCHED    @map("provider_matched")
  LEGACY_SUBSCRIPTION @map("legacy_subscription")

  @@map("billing_customer_provenance")
}

enum AccountTokenType {
  EMAIL_VERIFICATION @map("email_verification")
  PASSWORD_RESET     @map("password_reset")

  @@map("account_token_type")
}

model User {
  id                     String                  @id @default(uuid()) @db.Uuid
  email                  String                  @unique
  displayName            String?                 @map("display_name")
  passwordHash           String?                 @map("password_hash")
  sessionVersion         Int                     @default(0) @map("session_version")
  emailVerifiedAt        DateTime?               @map("email_verified_at")
  deletionRequestedAt    DateTime?               @map("deletion_requested_at")
  preferredCurrency      String                  @default("GBP") @map("preferred_currency")
  preferredRegion        String?                 @map("preferred_region")
  role                   UserRole                @default(USER)
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  subscriptions          Subscription[]
  createdSealed          SealedProduct[]         @relation("CreatedSealedProducts")
  storageLocations       StorageLocation[]
  collectionItems        CollectionItem[]
  wishlistItems          WishlistItem[]
  collectionEvents       CollectionEvent[]
  notificationPreference NotificationPreference?
  notificationDeliveries NotificationDelivery[]
  passwordResetOutbox     PasswordResetOutbox[]
  binders                 Binder[]
  accountTokens           AccountToken[]
  billingCheckoutIntents  BillingCheckoutIntent[]
  billingCustomers        BillingCustomer[]
  activeSetGoal           SetGoal?

  @@map("users")
}

model NotificationPreference {
  id                          String                      @id @default(uuid()) @db.Uuid
  userId                      String                      @unique @map("user_id") @db.Uuid
  priceAlertsEnabled          Boolean                     @default(true) @map("price_alerts_enabled")
  wishlistTargetAlertsEnabled Boolean                     @default(true) @map("wishlist_target_alerts_enabled")
  weakPriceAlertsEnabled      Boolean                     @default(true) @map("weak_price_alerts_enabled")
  digestFrequency             NotificationDigestFrequency @default(DAILY) @map("digest_frequency")
  createdAt                   DateTime                    @default(now()) @map("created_at")
  updatedAt                   DateTime                    @updatedAt @map("updated_at")
  user                        User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model NotificationDelivery {
  id                String                     @id @default(uuid()) @db.Uuid
  userId            String                     @map("user_id") @db.Uuid
  kind              String
  periodKey         String                     @map("period_key")
  recipientKey      String                     @map("recipient_key")
  status            NotificationDeliveryStatus @default(CLAIMED)
  providerMessageId String?                    @map("provider_message_id")
  errorCode         String?                    @map("error_code")
  sentAt            DateTime?                  @map("sent_at")
  ambiguousAt       DateTime?                  @map("ambiguous_at")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([kind, periodKey, recipientKey])
  @@index([userId, createdAt])
  @@index([status, updatedAt])
  @@map("notification_deliveries")
}

model PasswordResetOutbox {
  id                  String                    @id @default(uuid()) @db.Uuid
  userId              String?                   @map("user_id") @db.Uuid
  recipientKey        String                    @map("recipient_key")
  coalesceKey         String?                   @unique @map("coalesce_key")
  status              PasswordResetOutboxStatus @default(QUEUED)
  claimedAt           DateTime?                 @map("claimed_at")
  deliveryAttemptedAt DateTime?                 @map("delivery_attempted_at")
  sentAt              DateTime?                 @map("sent_at")
  discardedAt         DateTime?                 @map("discarded_at")
  unresolvedAt        DateTime?                 @map("unresolved_at")
  providerMessageId   String?                   @map("provider_message_id")
  errorCode           String?                   @map("error_code")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")
  user                User?                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("password_reset_outbox")
}

model JobRun {
  id             String       @id @default(uuid()) @db.Uuid
  jobType        JobRunType   @map("job_type")
  status         JobRunStatus @default(RUNNING)
  requestPayload Json         @default("{}") @map("request_payload")
  resultPayload  Json         @default("{}") @map("result_payload")
  errorMessage   String?      @map("error_message")
  startedAt      DateTime     @default(now()) @map("started_at")
  finishedAt     DateTime?    @map("finished_at")
  durationMs     Int?         @map("duration_ms")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([jobType, startedAt])
  @@index([status, startedAt])
  @@index([status, finishedAt])
  @@map("job_runs")
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @map("user_id") @db.Uuid
  provider               String
  providerCustomerId     String?            @unique @map("provider_customer_id")
  providerSubscriptionId String?            @unique @map("provider_subscription_id")
  plan                   SubscriptionPlan   @default(FREE)
  status                 SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd       DateTime?          @map("current_period_end")
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  providerUpdatedAt      DateTime?          @map("provider_updated_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([provider, providerCustomerId])
  @@map("subscriptions")
}

model CardSet {
  id             String          @id @default(uuid()) @db.Uuid
  providerIds    Json            @default("{}") @map("provider_ids")
  name           String
  language       String          @default("en")
  region         String          @default("international")
  series         String?
  releaseDate    DateTime?       @map("release_date") @db.Date
  printedTotal   Int?            @map("printed_total")
  total          Int?
  symbolImageUrl String?         @map("symbol_image_url")
  logoImageUrl   String?         @map("logo_image_url")
  metadata       Json            @default("{}")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  cardPrintings  CardPrinting[]
  sealedProducts SealedProduct[]
  setGoals       SetGoal[]

  @@index([name])
  @@index([language])
  @@index([region])
  @@index([series])
  @@map("card_sets")
}

model CardPrinting {
  id              String           @id @default(uuid()) @db.Uuid
  cardSetId       String           @map("card_set_id") @db.Uuid
  providerIds     Json             @default("{}") @map("provider_ids")
  name            String
  language        String           @default("en")
  region          String           @default("international")
  number          String
  rarity          String?
  supertype       String?
  subtypes        String[]
  artist          String?
  imageSmallUrl   String?          @map("image_small_url")
  imageLargeUrl   String?          @map("image_large_url")
  legalities      Json             @default("{}")
  variantMetadata Json             @default("{}") @map("variant_metadata")
  searchText      String           @map("search_text")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  cardSet         CardSet          @relation(fields: [cardSetId], references: [id], onDelete: Cascade)
  collectionItems CollectionItem[]
  wishlistItems   WishlistItem[]
  priceSnapshots  PriceSnapshot[]

  @@index([cardSetId])
  @@index([name])
  @@index([language])
  @@index([region])
  @@index([cardSetId, number])
  @@index([searchText])
  @@map("card_printings")
}

model SealedProduct {
  id               String              @id @default(uuid()) @db.Uuid
  createdByUserId  String?             @map("created_by_user_id") @db.Uuid
  relatedCardSetId String?             @map("related_card_set_id") @db.Uuid
  providerIds      Json                @default("{}") @map("provider_ids")
  name             String
  productType      SealedProductType   @map("product_type")
  releaseDate      DateTime?           @map("release_date") @db.Date
  imageUrl         String?             @map("image_url")
  notes            String?
  visibility       CatalogueVisibility @default(GLOBAL)
  metadata         Json                @default("{}")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  createdByUser    User?               @relation("CreatedSealedProducts", fields: [createdByUserId], references: [id], onDelete: SetNull)
  relatedCardSet   CardSet?            @relation(fields: [relatedCardSetId], references: [id], onDelete: SetNull)
  collectionItems  CollectionItem[]
  wishlistItems    WishlistItem[]
  priceSnapshots   PriceSnapshot[]

  @@index([name])
  @@index([productType])
  @@index([relatedCardSetId])
  @@index([createdByUserId])
  @@map("sealed_products")
}

model StorageLocation {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  name            String
  type            StorageLocationType
  notes           String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectionItems CollectionItem[]

  @@unique([userId, name])
  @@index([userId])
  @@map("storage_locations")
}

model CollectionItem {
  id                           String            @id @default(uuid()) @db.Uuid
  userId                       String            @map("user_id") @db.Uuid
  itemType                     ItemType          @map("item_type")
  cardPrintingId               String?           @map("card_printing_id") @db.Uuid
  sealedProductId              String?           @map("sealed_product_id") @db.Uuid
  quantity                     Int
  condition                    ItemCondition     @default(UNKNOWN)
  language                     String            @default("en")
  variantLabel                 String?           @map("variant_label")
  gradedCompany                GradingCompany?   @map("graded_company")
  gradedScore                  Decimal?          @map("graded_score") @db.Decimal(4, 1)
  purchasePriceMinor           Int?              @map("purchase_price_minor")
  purchaseCurrency             String?           @map("purchase_currency")
  purchaseDate                 DateTime?         @map("purchase_date") @db.Date
  currentValueOverrideMinor    Int?              @map("current_value_override_minor")
  currentValueOverrideCurrency String?           @map("current_value_override_currency")
  valuationNote                 String?           @map("valuation_note")
  storageLocationId            String?           @map("storage_location_id") @db.Uuid
  notes                        String?
  acquiredAt                   DateTime          @default(now()) @map("acquired_at")
  soldAt                       DateTime?         @map("sold_at")
  archivedAt                   DateTime?         @map("archived_at")
  createdAt                    DateTime          @default(now()) @map("created_at")
  updatedAt                    DateTime          @updatedAt @map("updated_at")
  user                         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardPrinting                 CardPrinting?     @relation(fields: [cardPrintingId], references: [id], onDelete: SetNull)
  sealedProduct                SealedProduct?    @relation(fields: [sealedProductId], references: [id], onDelete: SetNull)
  storageLocation              StorageLocation?  @relation(fields: [storageLocationId], references: [id], onDelete: SetNull)
  events                       CollectionEvent[]
  binderSlots                  BinderSlot[]

  @@index([userId])
  @@index([userId, itemType])
  @@index([userId, cardPrintingId])
  @@index([userId, sealedProductId])
  @@index([userId, storageLocationId])
  @@index([userId, archivedAt])
  @@map("collection_items")
}

model Binder {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  name        String
  description String?
  coverStyle  String           @default("forest") @map("cover_style")
  isDefault   Boolean          @default(false) @map("is_default")
  visibility  BinderVisibility @default(PRIVATE)
  shareSlug   String?          @unique @map("share_slug")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages       BinderPage[]

  @@unique([userId, name])
  @@index([userId, updatedAt])
  @@map("binders")
}

model BinderPage {
  id        String       @id @default(uuid()) @db.Uuid
  binderId  String       @map("binder_id") @db.Uuid
  position  Int
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  binder    Binder       @relation(fields: [binderId], references: [id], onDelete: Cascade)
  slots     BinderSlot[]

  @@unique([binderId, position])
  @@index([binderId])
  @@map("binder_pages")
}

model BinderSlot {
  id               String          @id @default(uuid()) @db.Uuid
  binderPageId     String          @map("binder_page_id") @db.Uuid
  collectionItemId String?         @map("collection_item_id") @db.Uuid
  position         Int
  copyIndex        Int?            @map("copy_index")
  note             String?
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  binderPage       BinderPage      @relation(fields: [binderPageId], references: [id], onDelete: Cascade)
  collectionItem   CollectionItem? @relation(fields: [collectionItemId], references: [id], onDelete: SetNull)

  @@unique([binderPageId, position])
  @@unique([collectionItemId, copyIndex])
  @@index([collectionItemId])
  @@map("binder_slots")
}

model WishlistItem {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  itemType         ItemType         @map("item_type")
  cardPrintingId   String?          @map("card_printing_id") @db.Uuid
  sealedProductId  String?          @map("sealed_product_id") @db.Uuid
  variantLabel     String?          @map("variant_label")
  targetPriceMinor Int?             @map("target_price_minor")
  targetCurrency   String?          @map("target_currency")
  priority         WishlistPriority @default(MEDIUM)
  notes            String?
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardPrinting     CardPrinting?    @relation(fields: [cardPrintingId], references: [id], onDelete: SetNull)
  sealedProduct    SealedProduct?   @relation(fields: [sealedProductId], references: [id], onDelete: SetNull)

  @@unique([userId, cardPrintingId])
  @@unique([userId, sealedProductId])
  @@index([userId])
  @@index([userId, priority])
  @@map("wishlist_items")
}

model SetGoal {
  id                      String           @id @default(uuid()) @db.Uuid
  userId                  String           @unique @map("user_id") @db.Uuid
  cardSetId               String           @map("card_set_id") @db.Uuid
  targetCompletionPercent Int              @default(100) @map("target_completion_percent")
  wishlistPriority        WishlistPriority @default(MEDIUM) @map("wishlist_priority")
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")
  user                    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardSet                 CardSet          @relation(fields: [cardSetId], references: [id], onDelete: Cascade)

  @@index([cardSetId])
  @@map("set_goals")
}

model PriceSnapshot {
  id              String          @id @default(uuid()) @db.Uuid
  itemType        ItemType        @map("item_type")
  cardPrintingId  String?         @map("card_printing_id") @db.Uuid
  sealedProductId String?         @map("sealed_product_id") @db.Uuid
  source          String
  sourceRef       String?         @map("source_ref")
  condition       ItemCondition?
  language        String?
  variantLabel    String?         @map("variant_label")
  gradedCompany   GradingCompany? @map("graded_company")
  gradedScore     Decimal?        @map("graded_score") @db.Decimal(4, 1)
  priceMinor      Int             @map("price_minor")
  currency        String
  confidenceScore Int             @map("confidence_score")
  sampleSize      Int?            @map("sample_size")
  observedAt      DateTime        @map("observed_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  metadata        Json            @default("{}")
  cardPrinting    CardPrinting?   @relation(fields: [cardPrintingId], references: [id], onDelete: Cascade)
  sealedProduct   SealedProduct?  @relation(fields: [sealedProductId], references: [id], onDelete: Cascade)

  @@index([itemType, cardPrintingId, observedAt])
  @@index([itemType, sealedProductId, observedAt])
  @@index([source, observedAt])
  @@index([currency, observedAt])
  @@map("price_snapshots")
}

model CollectionEvent {
  id               String              @id @default(uuid()) @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  collectionItemId String              @map("collection_item_id") @db.Uuid
  eventType        CollectionEventType @map("event_type")
  quantity         Int?
  amountMinor      Int?                @map("amount_minor")
  currency         String?
  occurredAt       DateTime            @map("occurred_at")
  notes            String?
  metadata         Json                @default("{}")
  createdAt        DateTime            @default(now()) @map("created_at")
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectionItem   CollectionItem      @relation(fields: [collectionItemId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([collectionItemId])
  @@index([userId, occurredAt])
  @@index([userId, eventType])
  @@map("collection_events")
}

model BillingWebhookEvent {
  id              String               @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String               @map("provider_event_id")
  eventType       String               @map("event_type")
  status          BillingWebhookStatus @default(PROCESSING)
  occurredAt      DateTime?            @map("occurred_at")
  processedAt     DateTime?            @map("processed_at")
  errorMessage    String?              @map("error_message")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@unique([provider, providerEventId])
  @@index([status, createdAt])
  @@index([status, processedAt])
  @@map("billing_webhook_events")
}

model BillingCheckoutIntent {
  id                 String           @id @default(uuid()) @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  provider           String
  plan               SubscriptionPlan
  status             String
  idempotencyKey     String           @unique @map("idempotency_key")
  leaseToken         String           @map("lease_token")
  leaseExpiresAt     DateTime          @map("lease_expires_at")
  providerCheckoutId String?          @map("provider_checkout_id")
  providerOrderId    String?          @map("provider_order_id")
  providerPaymentId  String?          @unique @map("provider_payment_id")
  providerCustomerId String?          @map("provider_customer_id")
  expectedAmountMinor Int?            @map("expected_amount_minor")
  expectedCurrency    String?         @map("expected_currency")
  providerPlanVariationId String?     @map("provider_plan_variation_id")
  checkoutOrigin     String           @map("checkout_origin")
  checkoutUrl        String?          @map("checkout_url")
  expiresAt          DateTime         @map("expires_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider, status, updatedAt])
  @@index([expiresAt])
  @@map("billing_checkout_intents")
}

model BillingCustomer {
  id                 String                    @id @default(uuid()) @db.Uuid
  userId             String                    @map("user_id") @db.Uuid
  provider           String
  providerCustomerId String                    @map("provider_customer_id")
  provenance         BillingCustomerProvenance @default(PROVIDER_MATCHED)
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerCustomerId])
  @@index([userId, provider])
  @@map("billing_customers")
}

model AccountToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      AccountTokenType
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at")
  usedAt    DateTime?        @map("used_at")
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
  @@index([expiresAt])
  @@map("account_tokens")
}

model AuthThrottle {
  keyHash         String    @id @map("key_hash")
  action          String
  attempts        Int       @default(0)
  windowStartedAt DateTime  @map("window_started_at")
  blockedUntil    DateTime? @map("blocked_until")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([blockedUntil])
  @@index([updatedAt])
  @@map("auth_throttles")
}
